# =============================================================================
# RekberKuy backend-ai environment template
# Copy to .env and fill in real values:  cp .env.example .env
# ⚠️  NEVER commit `.env` — it holds the Groq API key.
#
# NOTE: This service is VERIFICATION ONLY. The Go core-service owns every
# decision (fraud is_safe threshold, KYC approval). No threshold/policy is
# configured here — those live in core-service.
# =============================================================================

# ---- Groq (AI). Leave GROQ_API_KEY empty to run in low-confidence fallback mode.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile                       # text model (fraud)
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct  # vision model (KYC)

# ---- Server ----
HOST=0.0.0.0
PORT=8081                      # matches core-service's default AI_SERVICE_URL
RELOAD=false
LOG_LEVEL=INFO
