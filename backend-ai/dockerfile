# syntax=docker/dockerfile:1
FROM python:3.11-slim AS runtime
WORKDIR /app

# Cache pip install separately from source changes.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY main.py .

RUN useradd --system --no-create-home appuser
USER appuser

EXPOSE 8081
ENV HOST=0.0.0.0 PORT=8081

# Run uvicorn directly (not python main.py's __main__ reload path — that's
# for local dev only) so a crash exits the process cleanly for Compose/K8s
# restart policies to handle, instead of relying on the reload supervisor.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8081"]