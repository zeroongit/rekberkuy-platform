# =============================================================================
# RekberKuy — Dashboard Web (Next.js) environment template
# Copy to `.env.local` for local development:
#   cp .env.example .env.local
#
# Next.js loads `.env.local` automatically. Variables prefixed with
# NEXT_PUBLIC_ are exposed to the browser; keep server-only values un-prefixed.
# ⚠️  NEVER put secrets (service role keys) in NEXT_PUBLIC_ variables.
# =============================================================================

# Base URL of the Core Service (Go backend)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Supabase (client-safe keys only here; service role key stays backend-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Midtrans Snap client key (browser-side, safe to expose)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_ENVIRONMENT=sandbox

# Redis URL for server-side caching & session store (matches core-service)
REDIS_URL=redis://localhost:6379
