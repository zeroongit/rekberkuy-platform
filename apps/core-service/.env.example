# =============================================================================
# RekberKuy — Core Service environment template
# Copy this file to `.env` and fill in real values for your environment.
#   cp .env.example .env
# Other ready-to-use variants (gitignored): .env.development, .env.test
#
# ⚠️  NEVER commit `.env` or any variant containing real secrets.
#     Only `.env.example` is safe to commit.
# =============================================================================

# ---- App --------------------------------------------------------------------
APP_ENV=development              # development | staging | production
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000   # comma-separated allowed origins

# ---- Database (PostgreSQL via Supabase or local) ----------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/rekberkuy
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_HRS=1

# ---- Redis (cache + idempotency). Leave empty to fall back to PostgreSQL ----
REDIS_URL=
IDEMPOTENCY_TTL_SEC=86400        # seconds (24h)

# ---- Auth (JWT) -------------------------------------------------------------
# Required in production. If empty in development, a dev-only default is used.
JWT_SECRET=
JWT_TOKEN_LIFETIME=24h

# ---- Supabase (BaaS) --------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server-only — NEVER expose to the frontend

# ---- AI Service (backend-ai / Groq). backend-ai owns its own GROQ_API_KEY; ----
# core-service only needs to know where it is and how to decide on its score.
AI_SERVICE_URL=http://localhost:8081
FRAUD_SCREENING_ENABLED=false   # true = call backend-ai for scoring; false = always-safe stub
FRAUD_UNSAFE_THRESHOLD=0.5      # core-service's OWN decision: score >= threshold -> refuse release
# Fraud screening when backend-ai is unreachable: false (default) = refuse release
# (money-safe); true = assume safe (availability, not for production).
FRAUD_FAIL_OPEN=false

# ---- Blockchain (Avalanche gasless audit log) -------------------------------
# Leave all empty to use the stub relayer (no on-chain logging).
# Fuji testnet chain id = 43113, Mainnet = 43114.
AVALANCHE_RPC_URL=
DEPLOYER_PRIVATE_KEY=            # highly sensitive — deployer/relayer wallet
CONTRACT_ADDRESS=                # deployed TransactionLogger contract address
AVALANCHE_CHAIN_ID=43113

# ---- Payment Gateway (Midtrans) ---------------------------------------------
# Leave SERVER_KEY empty to disable Midtrans (top-up endpoint will reject).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENVIRONMENT=sandbox     # sandbox | production
MIDTRANS_WEBHOOK_KEY=

# ---- Notifications (SMTP) ---------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@rekberkuy.id
